<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <ProjectGuid>a5088bc9-29e6-4d2f-8569-167278d22fc2</ProjectGuid>
    <IsTestProject>true</IsTestProject>
    <!-- CS1591 (missing XML doc comment): test method names are the documentation, the same as the other test projects. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <!-- The AOT and trim gate for generated code. The generator runs over the fixtures in this project, so the trim
         analyzer (IL2xxx) and the AOT analyzer (IL3xxx) see the generated Register methods. As in src/, a CI build
         fails on any warning. -->
    <IsAotCompatible>true</IsAotCompatible>
    <TreatWarningsAsErrors Condition="'$(CI)' == 'true'">true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/TruthWeaver.Abstractions/TruthWeaver.Abstractions.csproj" />
    <ProjectReference Include="../../src/TruthWeaver/TruthWeaver.csproj" />
    <!-- Referenced as an assembly so the driver tests can create the generator directly. The copy below is what the
         compiler loads as an analyzer. -->
    <ProjectReference Include="../../src/TruthWeaver.Generators/TruthWeaver.Generators.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
    <PackageReference Include="coverlet.MTP" PrivateAssets="all" />
  </ItemGroup>

  <!-- The generator also runs over the fixtures in this project, but from a copy under obj/. An editor's language
       server loads an analyzer from its path and keeps the file open, which would block the next Debug build of
       src/TruthWeaver.Generators. It then locks the copy instead, and the copy is made fresh for each build. -->
  <Target Name="UseGeneratorCopyAsAnalyzer" BeforeTargets="CoreCompile" DependsOnTargets="ResolveReferences">
    <PropertyGroup>
      <GeneratorCopyDirectory>$([MSBuild]::NormalizeDirectory($(MSBuildProjectDirectory), $(IntermediateOutputPath), 'analyzer-copy'))</GeneratorCopyDirectory>
    </PropertyGroup>
    <ItemGroup>
      <GeneratorBuildOutput Include="@(ReferencePath)" Condition="'%(Filename)' == 'TruthWeaver.Generators'" />
    </ItemGroup>
    <Copy
      SourceFiles="@(GeneratorBuildOutput)"
      DestinationFolder="$(GeneratorCopyDirectory)"
      Retries="1"
      SkipUnchangedFiles="true"
    />
    <ItemGroup>
      <Analyzer Include="$(GeneratorCopyDirectory)TruthWeaver.Generators.dll" />
    </ItemGroup>
  </Target>
</Project>
