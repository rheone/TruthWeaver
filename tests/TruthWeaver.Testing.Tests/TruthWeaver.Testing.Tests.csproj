<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <ProjectGuid>9c87e632-35c2-494e-9123-bbf29f9b8ddd</ProjectGuid>
    <IsTestProject>true</IsTestProject>
    <!-- CS1591 (missing XML doc comment) still fires here even though Directory.Build.targets sets
         GenerateDocumentationFile=false for .Tests projects; test method names are the documentation
         (standard xUnit convention - CLAUDE.md's own SA1600/SA1633 suppression applies the same logic
         to production code), so this is suppressed explicitly rather than chased further. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/TruthWeaver.Abstractions/TruthWeaver.Abstractions.csproj" />
    <ProjectReference Include="../../src/TruthWeaver/TruthWeaver.csproj" />
    <ProjectReference Include="../../src/TruthWeaver.Testing/TruthWeaver.Testing.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="coverlet.MTP" PrivateAssets="all" />
    <!-- Validates the rule test files against rule-test.schema.json. -->
    <PackageReference Include="JsonSchema.Net" />
  </ItemGroup>

  <!-- The rule test samples, and the JUnit XSD (the Jenkins xunit-plugin junit-10.xsd, MIT) that the JUnit output is
       validated against. The schema of the test file is the shipped one from the Testing project. -->
  <ItemGroup>
    <None Include="RuleTests/**" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../src/TruthWeaver.Testing/rule-test.schema.json" Link="RuleTests/rule-test.schema.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
