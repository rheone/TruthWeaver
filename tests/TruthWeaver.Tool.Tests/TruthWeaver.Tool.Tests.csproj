<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <ProjectGuid>b42fe3d8-8ffe-4072-b67e-d1f05350717f</ProjectGuid>
    <IsTestProject>true</IsTestProject>
    <!-- CS1591 (missing XML doc comment) still fires here even though Directory.Build.targets sets
         GenerateDocumentationFile=false for .Tests projects; test method names are the documentation
         (standard xUnit convention - CLAUDE.md's own SA1600/SA1633 suppression applies the same logic
         to production code), so this is suppressed explicitly rather than chased further. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/TruthWeaver.Abstractions/TruthWeaver.Abstractions.csproj" />
    <ProjectReference Include="../../src/TruthWeaver/TruthWeaver.csproj" />
    <ProjectReference Include="../../src/TruthWeaver.Tool.Core/TruthWeaver.Tool.Core.csproj" />
    <ProjectReference Include="../../src/TruthWeaver.Tool/TruthWeaver.Tool.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="coverlet.MTP" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Samples/**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
