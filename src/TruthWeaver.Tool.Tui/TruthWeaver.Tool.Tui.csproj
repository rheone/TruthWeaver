<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <ProjectGuid>98761912-1057-48fa-8c95-cf7756ac5a65</ProjectGuid>
    <OutputType>Exe</OutputType>
    <RootNamespace>TruthWeaver.Tool.Tui</RootNamespace>
    <PackageId>TruthWeaver.Tool.Tui</PackageId>
    <Description>The truthweaver-tui terminal workbench: edit a TruthWeaver rule in rule text, JSON or YAML with live diagnostics, undo and redo, format, and a linked canonical view.</Description>
    <PackageTags>rules engine;kleene;k3;tui;dotnet-tool;truthweaver</PackageTags>
    <!-- A .NET tool package: `dotnet tool install TruthWeaver.Tool.Tui` gives the `truthweaver-tui` command. CI packs and
         checks it, but a release does not publish it yet (docs/tui.md, docs/releasing.md). -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>truthweaver-tui</ToolCommandName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../TruthWeaver.Abstractions/TruthWeaver.Abstractions.csproj" />
    <ProjectReference Include="../TruthWeaver/TruthWeaver.csproj" />
    <ProjectReference Include="../TruthWeaver.Yaml/TruthWeaver.Yaml.csproj" />
    <ProjectReference Include="../TruthWeaver.Tool.Core/TruthWeaver.Tool.Core.csproj" />
    <!-- The ready-made predicates, which the palette offers as templates (owner approval 2026-10-17). The workbench scans the
         public factories by reflection, so the tool core stays free of this reference. -->
    <ProjectReference Include="../TruthWeaver.Predicates/TruthWeaver.Predicates.csproj" />
    <!-- The rule test runner (RuleTestFile), the same runner as `truthweaver test` and C# tests. -->
    <ProjectReference Include="../TruthWeaver.Testing/TruthWeaver.Testing.csproj" />
  </ItemGroup>

  <!-- The terminal UI library is used here and nowhere else: the tool core and the command line stay free of it (an
       architecture test). -->
  <ItemGroup>
    <PackageReference Include="Terminal.Gui" />
    <PackageReference Include="Terminal.Gui.Editor" />
  </ItemGroup>

  <!-- The smoke tests build the workbench views without a terminal and drive them with keys. -->
  <ItemGroup>
    <InternalsVisibleTo Include="TruthWeaver.Tool.Tui.Tests" />
  </ItemGroup>
</Project>
