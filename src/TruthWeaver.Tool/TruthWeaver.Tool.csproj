<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <ProjectGuid>f6dd0a08-2528-4351-899f-711e56b13a4a</ProjectGuid>
    <OutputType>Exe</OutputType>
    <RootNamespace>TruthWeaver.Tool</RootNamespace>
    <PackageId>TruthWeaver.Tool</PackageId>
    <Description>The truthweaver command line: validate, convert, format, print, export, report, diff, evaluate and test TruthWeaver rules in rule text, JSON or YAML, with stub values for the predicates.</Description>
    <PackageTags>rules engine;kleene;k3;cli;dotnet-tool;truthweaver</PackageTags>
    <!-- A .NET tool package: `dotnet tool install TruthWeaver.Tool` gives the `truthweaver` command. A release publishes it
         with the other packages (docs/releasing.md). -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>truthweaver</ToolCommandName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../TruthWeaver.Abstractions/TruthWeaver.Abstractions.csproj" />
    <ProjectReference Include="../TruthWeaver/TruthWeaver.csproj" />
    <ProjectReference Include="../TruthWeaver.Yaml/TruthWeaver.Yaml.csproj" />
    <ProjectReference Include="../TruthWeaver.Tool.Core/TruthWeaver.Tool.Core.csproj" />
    <!-- The rule test runner of `truthweaver test` (RuleTestFile), the same runner that C# tests use. -->
    <ProjectReference Include="../TruthWeaver.Testing/TruthWeaver.Testing.csproj" />
  </ItemGroup>

  <!-- The command-line library is used here and nowhere else: the tool core stays UI-free (an architecture test). -->
  <ItemGroup>
    <PackageReference Include="System.CommandLine" />
  </ItemGroup>

  <!-- The in-process command tests call the internal entry point with their own console. -->
  <ItemGroup>
    <InternalsVisibleTo Include="TruthWeaver.Tool.Tests" />
  </ItemGroup>
</Project>
