{
  "$schema": "https://alirezanet.github.io/Husky.Net/schema.json",
  "tasks": [
    {
      "name": "normalize-text-staged",
      "group": "pre-commit",
      "command": "dotnet",
      "args": [
        "run",
        "scripts/normalize-text-staged.cs"
      ],
      "include": [
        "**/*.md",
        "**/*.txt",
        "**/*.cs",
        "**/*.py",
        "**/*.mjs",
        "**/*.sh",
        "**/*.yml",
        "**/*.yaml",
        "**/*.json",
        "**/*.props",
        "**/*.targets",
        "**/*.csproj",
        "**/*.slnx",
        "**/*.xsd"
      ]
    },
    {
      "name": "format-data-staged",
      "group": "pre-commit",
      "command": "dotnet",
      "args": [
        "run",
        "scripts/format-data-staged.cs"
      ],
      "include": [
        "**/*.json",
        "**/*.yaml",
        "**/*.yml"
      ]
    },
    {
      "name": "format-staged",
      "group": "pre-commit",
      "command": "dotnet",
      "args": [
        "run",
        "scripts/format-staged.cs"
      ],
      "include": [
        "**/*.cs"
      ]
    },
    {
      "name": "build",
      "group": "pre-commit",
      "command": "dotnet",
      "args": [
        "build",
        "--no-restore",
        "--configuration",
        "Release",
        "-p:CI=true"
      ],
      "include": [
        "**/*.cs",
        "**/*.csproj",
        "**/*.props",
        "**/*.targets",
        "**/*.slnx",
        "global.json"
      ]
    },
    {
      "name": "test",
      "group": "pre-commit",
      "command": "dotnet",
      "args": [
        "test",
        "--no-build",
        "--configuration",
        "Release"
      ],
      "include": [
        "**/*.cs",
        "**/*.csproj",
        "**/*.props",
        "**/*.targets",
        "**/*.slnx",
        "global.json"
      ]
    },
    {
      "name": "doc-tests",
      "group": "pre-commit",
      "command": "dotnet",
      "args": [
        "test",
        "tests/TruthWeaver.Tests",
        "--configuration",
        "Release",
        "--filter-class",
        "*DocumentationLint*",
        "--filter-class",
        "*K3Reference*",
        "--filter-class",
        "*DocExample*"
      ],
      "include": [
        "**/*.md"
      ]
    }
  ]
}
