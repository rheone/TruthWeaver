{
  "$schema": "https://alirezanet.github.io/Husky.Net/schema.json",
  "tasks": [
    {
      "name": "csharpier",
      "group": "pre-commit",
      "command": "dotnet",
      "args": ["csharpier", "format", "${staged}"],
      "include": ["**/*.cs"]
    },
    {
      "name": "dotnet-format",
      "group": "pre-commit",
      "command": "dotnet",
      "args": ["format", "--no-restore", "--severity", "info", "--include", "${staged}"],
      "include": ["**/*.cs"]
    },
    {
      "name": "restage",
      "group": "pre-commit",
      "command": "git",
      "args": ["add", "--", "${staged}"],
      "include": ["**/*.cs"]
    },
    {
      "name": "build",
      "group": "pre-commit",
      "command": "dotnet",
      "args": ["build", "--no-restore", "--configuration", "Release"]
    },
    {
      "name": "test",
      "group": "pre-commit",
      "command": "dotnet",
      "args": ["test", "--no-build", "--configuration", "Release"]
    }
  ]
}
