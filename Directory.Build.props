<Project>
  <PropertyGroup>
    <TargetFrameworks>net11.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- <TreatWarningsAsErrors>true</TreatWarningsAsErrors> -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsPackable>true</IsPackable>
    <!-- No Version here: MinVer derives it from the Git tag (see docs/contributing.md). A hand-set Version, or
         VersionPrefix/VersionSuffix, would fight MinVer. A tag `v1.2.3` gives 1.2.3 on that commit. A later
         commit gives 1.2.4-preview.0.N (N = commits since the tag). With no tag the version is 1.0.0-preview.0.N
         because of MinVerMinimumMajorMinor. -->
    <MinVerTagPrefix>v</MinVerTagPrefix>
    <MinVerDefaultPreReleaseIdentifiers>preview.0</MinVerDefaultPreReleaseIdentifiers>
    <MinVerMinimumMajorMinor>1.0</MinVerMinimumMajorMinor>
    <Authors>Robert H. Engelhardt</Authors>
    <!-- No Company: this is an individual-authored project, not published under a company entity - Authors
         above already carries attribution. Deliberately omitted rather than a placeholder value. -->
    <Copyright>Copyright 2026 Robert H. Engelhardt</Copyright>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <RepositoryUrl>https://github.com/rheone/TruthWeaver</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/rheone/TruthWeaver</PackageProjectUrl>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <!-- Fallback only: every packable src project sets its own PackageId, Description and PackageTags. -->
    <PackageTags>rules engine;kleene;k3;truthweaver</PackageTags>
    <PackageReleaseNotes>See https://github.com/rheone/TruthWeaver/blob/main/CHANGELOG.md</PackageReleaseNotes>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <!-- No PackageIcon yet: no icon asset exists in the repo, and a placeholder image is worse than none -
         add one and set PackageIcon when real branding exists, rather than shipping a fabricated stand-in. -->
    <!-- Symbol packages + deterministic builds: the standard pairing with the SDK's built-in Source Link so a
         consumer's debugger can step into this package's source from nuget.org/a symbol server. -->
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <!-- NuGetAudit checks every direct and transitive package against the NuGet.org advisory database at restore time.
       The mode and level take in every package and every severity, including low. In CI a vulnerability warning
       (NU1901 low, NU1902 moderate, NU1903 high, NU1904 critical) and NU1900 (the audit could not run) fail the build.
       A local build keeps them as warnings. To accept a known advisory, fix it with a transitive pin in
       Directory.Packages.props, not by turning the audit off. -->
  <PropertyGroup>
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <NuGetAuditLevel>low</NuGetAuditLevel>
    <WarningsAsErrors Condition="'$(CI)' == 'true'">$(WarningsAsErrors);NU1900;NU1901;NU1902;NU1903;NU1904</WarningsAsErrors>
  </PropertyGroup>

  <!-- Package README - every packable project ships the repo root README as its NuGet readme. -->
  <ItemGroup Condition="'$(IsPackable)' == 'true'">
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

  <PropertyGroup>
    <!-- AD0001: Roslyn analyzer failure (an analyzer threw an exception). Recheck on each .NET SDK or analyzer upgrade
         and remove it once no analyzer throws. -->
    <!-- SA1633: File should have a header. Recheck on each StyleCop.Analyzers upgrade, together with the SA1600 and
         SA1633 entries in .editorconfig. -->
    <NoWarn>$(NoWarn)AD0001;SA1633</NoWarn>
  </PropertyGroup>

  <!-- Shared BCL usings - promoted to global so SA1200 (using directives must appear within a
       namespace) never fights csharp_style_namespace_declarations=file_scoped: a file-scoped
       namespace has no block for a using to live inside, so any BCL namespace beyond
       ImplicitUsings' defaults belongs here instead of a per-file using directive. -->
  <ItemGroup>
    <Using Include="System.Collections.Concurrent" />
    <Using Include="System.Collections.Immutable" />
    <Using Include="System.Globalization" />
    <Using Include="System.Text" />
  </ItemGroup>

  <!-- Shared AdditionalFiles -->
  <ItemGroup>
    <AdditionalFiles Include="$(MSBuildThisFileDirectory).editorconfig" Link=".editorconfig" />
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)stylecop.json" Link="stylecop.json" />
  </ItemGroup>
</Project>
