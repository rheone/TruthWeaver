<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <!-- The analyzer packages and Source Link below are GlobalPackageReference items, not PackageVersion items.
       A global reference applies to every project in the repository (src, tests, samples, benchmarks and the
       netstandard2.0 generator) from this one file, so a new project gets the same analyzers without a
       PackageReference in Directory.Build.props. PrivateAssets="all" keeps them out of the packages we ship.
       NSubstitute.Analyzers.CSharp stays a PackageReference in the test projects that use NSubstitute. -->
  <!-- Roslynator. (Roslynator.CodeFixes/Roslynator.Refactorings are IDE-extension-only packages,
       not referenced by any PackageReference here, so they are deliberately not pinned.) -->
  <ItemGroup>
    <GlobalPackageReference Include="Roslynator.Analyzers" Version="5.0.1" PrivateAssets="all" />
    <GlobalPackageReference Include="Roslynator.CodeAnalysis.Analyzers" Version="5.0.1" PrivateAssets="all" />
    <GlobalPackageReference Include="Roslynator.Formatting.Analyzers" Version="5.0.1" PrivateAssets="all" />
  </ItemGroup>
  <!-- StyleCop -->
  <ItemGroup>
    <!-- 1.2.0-beta is required for record support: 1.1.x SA1313 flags PascalCase positional-record
         parameters, which are correct (they become public properties). -->
    <GlobalPackageReference Include="StyleCop.Analyzers" Version="1.2.0-beta.556" PrivateAssets="all" />
  </ItemGroup>
  <!-- SonarAnalyzer -->
  <ItemGroup>
    <GlobalPackageReference Include="SonarAnalyzer.CSharp" Version="10.35.0.4138" PrivateAssets="all" />
  </ItemGroup>
  <!-- Async/await usage analyzers -->
  <ItemGroup>
    <GlobalPackageReference Include="AsyncFixer" Version="2.1.0" PrivateAssets="all" />
    <GlobalPackageReference Include="Microsoft.VisualStudio.Threading.Analyzers" Version="18.7.23" PrivateAssets="all" />
  </ItemGroup>
  <!-- IDisposable usage analyzer -->
  <ItemGroup>
    <GlobalPackageReference Include="IDisposableAnalyzers" Version="4.0.8" PrivateAssets="all" />
  </ItemGroup>
  <!-- Microsoft extensions (ship with .NET 11). Abstractions packages are what TruthWeaver
       itself depends on (ADR-0004); the non-Abstractions packages are test-only, wiring a real DI
       container/logger in the DI-registration-extension tests (ticket 12). -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="11.0.0-rc.1.26425.128" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="11.0.0-rc.1.26425.128" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="11.0.0-rc.1.26425.128" />
    <PackageVersion Include="Microsoft.Extensions.Logging" Version="11.0.0-rc.1.26425.128" />
  </ItemGroup>
  <!-- Meziantou.Framework.JsonPath - TruthWeaver.DataSources.Json's JSONPath (RFC 9535) engine (ADR-0006). MIT, no dependencies,
       a net11.0 build, evaluates System.Text.Json JsonNode directly and is actively maintained. Chosen over JsonPath.Net, whose
       3.x binaries ship under the Open Source Maintenance Fee EULA. -->
  <ItemGroup>
    <PackageVersion Include="Meziantou.Framework.JsonPath" Version="3.0.7" />
  </ItemGroup>
  <!-- YamlDotNet - TruthWeaver.Yaml's sole dependency beyond TruthWeaver itself. -->
  <ItemGroup>
    <PackageVersion Include="YamlDotNet" Version="18.1.0" />
  </ItemGroup>
  <!-- System.CommandLine - the truthweaver command line (TruthWeaver.Tool) only: option parsing, help and shell completion.
       2.0.x is the stable line (MIT, a net8.0 build with no dependencies, marked IsTrimmable and free of
       RequiresUnreferencedCode/RequiresDynamicCode). No other project may reference it; an architecture test checks the
       tool core. -->
  <ItemGroup>
    <PackageVersion Include="System.CommandLine" Version="2.0.12" />
  </ItemGroup>
  <!-- Roslyn - TruthWeaver.Generators builds against these, and its test project drives the generator with them.
       4.14.0 is the oldest compiler API with AddEmbeddedAttributeDefinition (the generated marker attribute stays
       invisible outside each consuming compilation). A consumer needs the .NET 9.0.300 SDK or later to load it. -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.Analyzers" Version="3.11.0" />
  </ItemGroup>
  <!-- xUnit v3 + MTP test packages -->
  <ItemGroup>
    <PackageVersion Include="xunit.v3" Version="4.0.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
    <PackageVersion Include="Microsoft.Testing.Platform" Version="2.4.0" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <!-- coverlet.MTP, not coverlet.collector (a VSTest data collector, which the
         UseMicrosoftTestingPlatformRunner test host below cannot load), is the native
         Microsoft.Testing.Platform coverage extension; run via the "coverlet" CLI flag
         documented at https://github.com/coverlet-coverage/coverlet. -->
    <PackageVersion Include="coverlet.MTP" Version="10.1.0" />
  </ItemGroup>
  <!-- NSubstitute -->
  <ItemGroup>
    <PackageVersion Include="NSubstitute" Version="6.2.0" />
    <PackageVersion Include="NSubstitute.Analyzers.CSharp" Version="1.0.17" />
  </ItemGroup>
  <!-- JsonSchema.Net - test-project-only, to validate rule-tree.schema.json against the compiler's own
       JSON fixtures (ticket: JSON Schema for the rule tree). Not referenced by any shipping project;
       the schema itself is packaged as a plain content file, not consumed by production code. -->
  <ItemGroup>
    <PackageVersion Include="JsonSchema.Net" Version="9.4.0" />
  </ItemGroup>
  <!-- CsCheck - test-project-only, property-based/generative testing for the DSL printer/parser
       round-trip (ticket: DSL round-trip property testing). Chosen over FsCheck: pure C# (no F#
       runtime dependency to pull into a C#-only repo), PCG-based generation and shrinking that is
       fast and fully automatic (no hand-written Arbitrary/shrink instances), and every failure
       reports a replayable seed. Not referenced by any shipping project. -->
  <ItemGroup>
    <PackageVersion Include="CsCheck" Version="4.9.1" />
  </ItemGroup>
  <!-- MinVer derives every package version from the Git tags. It is a build-only reference, and only for projects that
       pack, so test, sample and benchmark projects carry no MinVer version logic. -->
  <ItemGroup>
    <GlobalPackageReference Include="MinVer" Version="8.0.0" PrivateAssets="all" Condition="'$(IsPackable)' != 'false'" />
  </ItemGroup>
  <!-- Source Link comes from the .NET SDK, which bundles Microsoft.SourceLink.GitHub, so no package reference is needed.
       Do not add the Microsoft.SourceLink.GitHub package as a GlobalPackageReference: it sets SuppressImplicitGitSourceLink,
       which switches off the SDK Source Link. In this repository no Source Link target then ran, so the packed
       assemblies had no sourcelink.json and the symbol packages had no source link (found by the check in docs/releasing.md). -->
  <!-- NetArchTest - architecture-test-project-only, asserting the ADR-0004 package-boundary rules
       (e.g. TruthWeaver.Abstractions has zero dependencies on the other TruthWeaver.* assemblies,
       TruthWeaver.Predicates/Testing depend on Abstractions alone) as a build-time check rather than
       something only a code reviewer notices. Not referenced by any shipping project. -->
  <ItemGroup>
    <PackageVersion Include="NetArchTest.Rules" Version="1.3.2" />
  </ItemGroup>
  <!-- BenchmarkDotNet - benchmarks-project-only (ticket: BenchmarkDotNet suite for compile and eval
       performance). Never referenced by src/ or shipped in any package; the benchmarks project is a
       throwaway console app that measures RuleCompiler/CompiledRule performance from outside the
       library. -->
  <ItemGroup>
    <PackageVersion Include="BenchmarkDotNet" Version="0.15.8" />
  </ItemGroup>
</Project>
