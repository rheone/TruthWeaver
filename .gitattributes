# LF is the repository default on every platform: the index, the working tree and CI agree, so a scripted
# edit, a Linux CI runner and Windows tooling never disagree about line endings. `text=auto` lets Git
# detect binary files; `eol=lf` pins the checked-out form regardless of core.autocrlf.
* text=auto eol=lf

# Files that need CRLF to work with Windows tools: cmd.exe batch files misparse labels in LF files, and
# the legacy .sln parser in Visual Studio rewrites a file whose endings are not CRLF. (.slnx is XML and
# stays LF.)
*.bat text eol=crlf
*.cmd text eol=crlf
*.sln text eol=crlf

# Shell scripts and Git hooks break with CRLF ("bad interpreter"), so they are LF even if the default above
# ever changes.
*.sh text eol=lf
.husky/** text eol=lf

# Binary artifacts: never normalised or diffed as text.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.svgz binary
*.pdf binary
*.zip binary
*.gz binary
*.7z binary
*.nupkg binary
*.snupkg binary
*.snk binary
*.pfx binary
*.dll binary
*.exe binary
*.pdb binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary

# Markdown shows readable diffs; C# gets the C# hunk-header heuristic.
*.md text diff=markdown
*.cs text diff=csharp

# Skill files are hashed byte for byte by `npx skills` (skills-lock.json), so their line endings must never
# depend on a contributor's core.autocrlf. LF in the index and in every working tree keeps the lock hash valid.
.claude/skills/** text eol=lf
