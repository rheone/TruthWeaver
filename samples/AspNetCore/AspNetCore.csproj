<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <RootNamespace>TruthWeaver.Samples.AspNetCore</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- The Web SDK warns when `dotnet pack` meets a non-packable project, and the CI pack step runs with
         -warnaserror over the whole solution. A sample is never packed, so silence that warning. -->
    <WarnOnPackingNonPackableProject>false</WarnOnPackingNonPackableProject>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/TruthWeaver.Abstractions/TruthWeaver.Abstractions.csproj" />
    <ProjectReference Include="../../src/TruthWeaver/TruthWeaver.csproj" />
    <ProjectReference Include="../../src/TruthWeaver.AspNetCore/TruthWeaver.AspNetCore.csproj" />
  </ItemGroup>
</Project>
