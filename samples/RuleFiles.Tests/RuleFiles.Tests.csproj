<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>TruthWeaver.Samples.RuleFiles.Tests</RootNamespace>
    <!-- Test names are the documentation, as in the repository test projects. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/TruthWeaver.Tool.Core/TruthWeaver.Tool.Core.csproj" />
    <ProjectReference Include="../../src/TruthWeaver.Testing/TruthWeaver.Testing.csproj" />
  </ItemGroup>

  <!-- The rule file and the rule test file belong to the sample. The tests read them from the output folder. -->
  <ItemGroup>
    <None Include="../RuleFiles/publish.rule" Link="RuleFiles/publish.rule" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../RuleFiles/publish.test.yaml" Link="RuleFiles/publish.test.yaml" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="coverlet.MTP" PrivateAssets="all" />
  </ItemGroup>
</Project>
