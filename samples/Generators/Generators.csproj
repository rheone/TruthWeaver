<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>TruthWeaver.Samples.Generators</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/TruthWeaver.Abstractions/TruthWeaver.Abstractions.csproj" />
    <ProjectReference Include="../../src/TruthWeaver/TruthWeaver.csproj" />
    <!-- In this repository the generator is referenced as an analyzer. A consumer uses a PackageReference
         to TruthWeaver.Generators with PrivateAssets="all". -->
    <ProjectReference
      Include="../../src/TruthWeaver.Generators/TruthWeaver.Generators.csproj"
      OutputItemType="Analyzer"
      ReferenceOutputAssembly="false"
    />
  </ItemGroup>
</Project>
