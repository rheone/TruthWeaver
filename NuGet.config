<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <!-- Source mapping: a package id comes only from a source that maps it. nuget.org is the only source, so one
       pattern covers every id. Add a source and its own patterns together, so that no package id can come from a
       source that was not meant to serve it. -->
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
