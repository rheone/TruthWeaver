# Build output
[Bb]in/
[Oo]bj/
artifacts/

# IDEs
.vs/
.idea/
.fleet/
_ReSharper*/
*.DotSettings.user
*.user
*.suo

# Local agent/tool state (generated indexes, per-machine CLI config)
.codegraph/
.codex/
.cursor/

# VS Code: keep shared project configuration if added later
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# Test output
TestResults/
*.trx

# Coverage output
coverage/
coverage-results/
*.coverage
*.coveragexml
lcov.info

# Mutation-testing output (Stryker.NET)
StrykerOutput/

# BenchmarkDotNet run output (not the committed baseline under benchmarks/*/results/)
BenchmarkDotNet.Artifacts/

# MSBuild logs
*.binlog
msbuild.log

# NuGet
*.nupkg
*.snupkg
packages/
.nuget/

# Generated documentation
*.xml

# CSharpier
.csharpier/

# OS
.DS_Store
Thumbs.db
Desktop.ini

# Local Claude state (project skills and settings under .claude/ are committed)
.claude/local/
.claude/worktrees/
.claude/scheduled_tasks.lock

# Python bytecode (skill helper scripts)
__pycache__/
*.pyc

# Temporary files
*.tmp
*.temp
*.swp
*.bak
*.orig
.tmp
